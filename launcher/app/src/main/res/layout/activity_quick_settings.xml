<?xml version="1.0" encoding="utf-8"?>
<!-- Quick settings opened by the remote's Settings button: a tall glass panel at the right edge, in the
     manner of Google TV's own, with the date and clock, a gear for the full TV settings and a two-column grid
     of tiles. Over Home or any app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:layout_marginEnd="28dp"
        android:orientation="vertical"
        android:background="@drawable/glass_panel"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="20dp"
        android:paddingBottom="18dp"
        android:elevation="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp">

            <TextClock
                android:id="@+id/qsDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:format12Hour="EEE, MMM d"
                android:format24Hour="EEE, MMM d"
                android:textColor="#D9FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@string/font_medium" />

            <TextClock
                android:id="@+id/qsTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/qsDate"
                android:layout_alignParentStart="true"
                android:layout_marginTop="2dp"
                android:format12Hour="h:mm a"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFFFF"
                android:textSize="34sp"
                android:fontFamily="@string/font_light" />

            <!-- Language: א/A and the language in use; OK switches the launcher between Hebrew and English. -->
            <LinearLayout
                android:id="@+id/qsLang"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_toStartOf="@+id/qsGear"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:background="@drawable/qs_tile_bg"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/qs_language">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="א/A"
                    android:textColor="@drawable/pill_text"
                    android:duplicateParentState="true"
                    android:textSize="16sp"
                    android:fontFamily="@string/font_medium"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/qsLangName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@drawable/pill_text_dim"
                    android:duplicateParentState="true"
                    android:textSize="13sp"
                    android:fontFamily="@string/font_regular" />
            </LinearLayout>

            <ImageView
                android:id="@+id/qsGear"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="11dp"
                android:src="@drawable/ic_settings"
                android:tint="@drawable/pill_text"
                android:background="@drawable/qs_gear_bg"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/tv_settings" />
        </RelativeLayout>

        <!-- Tiles, Spotify and the paired devices scroll under the clock as focus moves down. -->
        <ScrollView
            android:id="@+id/tilesScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="vertical">

            <GridLayout
                android:id="@+id/tiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="false" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
