<?xml version="1.0" encoding="utf-8"?>
<!-- A control on glass: frosted at rest, solid white when focused, faint when it has nothing to do. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_fill" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/control_disabled" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/control_fill_top" android:endColor="@color/control_fill" />
            <stroke android:width="1dp" android:color="@color/control_edge" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
</selector>
