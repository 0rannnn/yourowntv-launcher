<?xml version="1.0" encoding="utf-8"?>
<!-- A round visionOS toggle: white while focused, blue while on, a brighter frost otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval"><solid android:color="@color/focus_fill" /></shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="oval"><solid android:color="@color/vision_on" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="@color/vision_control" /></shape>
    </item>
</selector>
