<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted pill, tvOS style: the same glass controls as the quick settings panel, white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_fill" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2BFFFFFF" android:endColor="#12FFFFFF" />
            <stroke android:width="1dp" android:color="@color/control_edge" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
</selector>
